rules_version = '2';

// RK StaffHub — Firestore security rules
//
// Mirrors src/lib/permissions/* server-side. The client helpers decide what to
// SHOW; these rules decide what is ALLOWED. Spec §4, §17.
//
// ── ACCEPTED SPEC DEVIATION (approved by Rafa, Aug 13 2026) ──────────────────
// Spec §17 requires field-level read control ("staff read own profile minus
// schedulingNotes/rates"; "a Manager cannot see another Manager's salary").
// Firestore has NO field-level read security — rules gate whole documents.
// With hourlyRate/salaryAmount/schedulingNotes on employees/{id} as §3 lists
// them, any rule permitting a roster read also leaks every salary.
//
// Permanent resolution: sensitive fields live in gated subdocuments.
//   employees/{id}                      ← non-sensitive profile; broadly readable
//   employees/{id}/private/compensation ← hourlyRate, salaryAmount, salaryPeriod
//   employees/{id}/private/admin        ← schedulingNotes, permissionOverrides
// The logical model in §3 is unchanged; only the physical layout differs.
//
// ── DEFENSIVE EVALUATION (why every read is guarded) ─────────────────────────
// A rule that THROWS denies the request, but it denies it dirtily: the emulator
// logs "evaluation error", the deny reason is unreadable, and — more dangerous —
// an expression that throws on the deny path can equally throw on an ALLOW path
// once a document shape changes, turning a legitimate grant into a mystery 403.
//
// So: every get() is guarded by exists(), and every field read uses `in` plus
// indexing rather than a chained .get(field, default) or bare dot access.
// Defaults FAIL CLOSED — a missing employee doc resolves to accessRole 'owner'
// (the highest rank), so a missing parent can never widen access. Never
// introduce an unguarded get() or a bare field access below.
//
// ── "evaluation error" ON A WRITE RULE IS NOT A DEFECT (measured Aug 2026) ───
// A WRITE rule is evaluated TWICE. The first pass runs before the emulator has
// fetched anything — its purpose is to discover which documents the rule wants
// — so every get() in the expression is unresolved and reports "evaluation
// error at L…". The emulator then fetches and re-evaluates, and that second
// pass is the verdict, which is why such a trace always ends with a clean
// `false for '<op>' @ L<same line>`. READ rules have no speculative pass and
// never show it.
//
// This is unavoidable for any write rule that consults a permission document —
// i.e. every write rule here — and guarding does NOT suppress it: a get()
// throws in pass one even when its exists() guard is false, even behind a
// ternary, and even in the branch that is never taken. Probe results and the
// full method are recorded in scripts/check-rules-clean.mjs, which now fails
// only on an evaluation error that never reaches a verdict. Do not rewrite a
// rule to chase one of these; do not re-run the bisection.
//
// The hygiene above still stands on its own merits: it is what keeps a rule
// CORRECT when a document is missing or a field absent, which is a different
// problem and a real one.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── identity ─────────────────────────────────────────────────────────────
    // role + employeeId arrive as custom claims, set by the acceptInvite /
    // setEmployeeClaims Functions and the onEmployeeRoleChange trigger
    // (spec §2). Claims keep the common path to zero extra reads.

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return (signedIn() && 'role' in request.auth.token)
        ? request.auth.token.role
        : 'none';
    }

    function myEmployeeId() {
      return (signedIn() && 'employeeId' in request.auth.token)
        ? request.auth.token.employeeId
        : '';
    }

    function hasIdentity() {
      return signedIn() && myEmployeeId() != '';
    }

    function isSelf(employeeId) {
      return hasIdentity() && myEmployeeId() == employeeId;
    }

    // Access-role hierarchy, high → low (spec §4).
    // An unknown role ranks 0, below staff — an unrecognised claim grants nothing.
    function rank(role) {
      return role == 'owner' ? 5
           : role == 'gm' ? 4
           : role == 'manager' ? 3
           : role == 'supervisor' ? 2
           : role == 'staff' ? 1
           : 0;
    }

    // ── guarded document reads ───────────────────────────────────────────────

    // An empty path segment makes a MALFORMED path, and rules construct paths
    // eagerly rather than short-circuiting on the guarding &&. So an absent or
    // empty employeeId claim would throw before hasIdentity() could deny it.
    // Substituting a sentinel that can never exist keeps the denial clean.
    function safeId(employeeId) {
      return (employeeId is string && employeeId != '') ? employeeId : '__nobody__';
    }

    function employeePath(employeeId) {
      return /databases/$(database)/documents/employees/$(safeId(employeeId));
    }

    function adminPath(employeeId) {
      return /databases/$(database)/documents/employees/$(safeId(employeeId))/private/admin;
    }

    function roleDefaultsPath() {
      return /databases/$(database)/documents/permissions/roleDefaults;
    }

    // These read maps with `in` + bracket indexing rather than chained
    // .get(key, default). A chained .get() on a nested document map evaluates
    // DIRTILY here — proven by bisection: exists() alone is clean, and adding
    // the .get() chain reintroduced 8 evaluation errors. `in` guards each level
    // explicitly, so every miss yields a value instead of throwing.

    // Missing roleDefaults ⇒ empty map ⇒ every permission resolves false.
    function roleDefaults() {
      return exists(roleDefaultsPath())
        ? defaultsOf(get(roleDefaultsPath()).data)
        : {};
    }

    function defaultsOf(data) {
      return 'defaults' in data ? data.defaults : {};
    }

    // Missing private/admin ⇒ no overrides ⇒ fall through to role defaults.
    function myOverrides() {
      return (hasIdentity() && exists(adminPath(myEmployeeId())))
        ? overridesOf(get(adminPath(myEmployeeId())).data)
        : {};
    }

    function overridesOf(data) {
      return 'permissionOverrides' in data ? data.permissionOverrides : {};
    }

    // Rules do NOT memoize function results: every call to roleDefaults() or
    // myOverrides() re-runs its exists()+get(). Calling them repeatedly inside
    // one condition multiplies document accesses and the evaluation blows up
    // rather than returning false — which is exactly the dirty-denial symptom.
    //
    // So the maps are resolved ONCE at the call site and passed in as
    // parameters. Everything below indexes parameters, which is free.
    function grantedBy(key, defaults, role) {
      return role in defaults
             && key in defaults[role]
             && defaults[role][key] == true;
    }

    function effectivePerm(key, overrides, defaults, role) {
      return key in overrides
        ? overrides[key] == true
        : grantedBy(key, defaults, role);
    }

    // Missing employee doc ⇒ 'owner', the HIGHEST rank. Fails closed: a missing
    // parent document can never widen anyone's access.
    function targetRoleOf(employeeId) {
      return exists(employeePath(employeeId))
        ? roleOf(get(employeePath(employeeId)).data)
        : 'owner';
    }

    function roleOf(data) {
      return 'accessRole' in data ? data.accessRole : 'owner';
    }

    // ── permissions ──────────────────────────────────────────────────────────

    // Effective permission = override ?? roleDefault. Mirrors hasPermission().
    // Effective permission = override ?? roleDefault. Mirrors hasPermission().
    // myOverrides() and roleDefaults() are each evaluated exactly once here.
    function hasPerm(key) {
      return hasIdentity()
        && effectivePerm(key, myOverrides(), roleDefaults(), myRole());
    }

    // The "below your level" rule (spec §4). Mirrors canAccessSensitive().
    // Self → yes. Owner → yes. Strictly-lower rank → yes. EQUAL RANK → NO.
    function canAccessSensitive(employeeId) {
      return hasIdentity() && (
        myEmployeeId() == employeeId
        || myRole() == 'owner'
        || rank(myRole()) > rank(targetRoleOf(employeeId))
      );
    }

    // ── department scoping (spec §5, §6, §17) ────────────────────────────────
    // A manager approves for THEIR department; owner and GM are house-wide.
    //
    // `department` is not a custom claim, so it costs one employee read per
    // side. Both are resolved ONCE per condition and passed down as parameters,
    // for the same non-memoization reason documented above.
    //
    // The two sides fail closed to DIFFERENT sentinels on purpose. A single
    // shared sentinel would make two departmentless documents compare EQUAL,
    // which would turn a pair of broken records into a grant.

    function actorDeptOf(data) {
      return 'department' in data ? data.department : '__no_actor_dept__';
    }

    function myDepartment() {
      return (hasIdentity() && exists(employeePath(myEmployeeId())))
        ? actorDeptOf(get(employeePath(myEmployeeId())).data)
        : '__no_actor_dept__';
    }

    function targetDeptOf(data) {
      return 'department' in data ? data.department : '__no_target_dept__';
    }

    function departmentOfTarget(employeeId) {
      return exists(employeePath(employeeId))
        ? targetDeptOf(get(employeePath(employeeId)).data)
        : '__no_target_dept__';
    }

    // Owner and GM run the whole house and are not department-scoped (spec §4).
    function ownerOrGm() {
      return myRole() == 'owner' || myRole() == 'gm';
    }

    // ONE call to myDepartment() and ONE to departmentOfTarget() per condition.
    function scopedTo(employeeId) {
      return hasIdentity()
        && (ownerOrGm() || myDepartment() == departmentOfTarget(employeeId));
    }

    // Two schedule permissions read from ONE already-resolved pair of maps —
    // calling hasPerm() twice would double every document access.
    function canEditSchedules(overrides, defaults, role) {
      return effectivePerm('schedule.create', overrides, defaults, role)
          || effectivePerm('schedule.edit', overrides, defaults, role);
    }

    // ── schedule publication state ───────────────────────────────────────────
    // A week is live only once it has been published or republished. Anything
    // else — including a missing or malformed status — is a DRAFT, and a draft
    // is never visible to staff.

    function isLiveStatus(status) {
      return status == 'published' || status == 'republished';
    }

    function schedulePath(weekId) {
      return /databases/$(database)/documents/schedules/$(safeId(weekId));
    }

    function liveStatusOf(data) {
      return 'status' in data && isLiveStatus(data.status);
    }

    // Missing week document ⇒ NOT published. Fails closed.
    function weekIsPublished(weekId) {
      return exists(schedulePath(weekId)) && liveStatusOf(get(schedulePath(weekId)).data);
    }

    // ── employees ────────────────────────────────────────────────────────────
    // Non-sensitive profile. Any signed-in employee may read the roster — names,
    // roles and departments are needed to render a schedule. Sensitive data
    // lives under /private (below).

    match /employees/{employeeId} {

      // Privileged fields are compared one by one rather than via
      // diff().affectedKeys().hasAny(). The diff/Set path evaluates dirtily
      // whenever a privileged key actually changes — exactly the case that
      // matters — and a rule that throws is a rule whose deny reason nobody can
      // read. Explicit equality also states the intent plainly: these fields
      // must be IDENTICAL before and after a self-edit.

      // TOTAL cross-object comparison. Each access is guarded by an `in` on
      // the SAME object it reads — never on the other one. A field that is
      // absent from both is unchanged; present in only one is a change.
      // Absent ⇒ 'owner', the highest rank: an omitted role can never be a
      // legal grant.
      function incomingRole() {
        return 'accessRole' in request.resource.data
          ? request.resource.data.accessRole
          : 'owner';
      }

      function unchanged(field) {
        return (field in request.resource.data) == (field in resource.data)
          && (!(field in request.resource.data)
              || request.resource.data[field] == resource.data[field]);
      }

      // Fields an employee may never change about themselves.
      function selfEditIsBenign() {
        return unchanged('accessRole')
          && unchanged('status')
          && unchanged('employmentType')
          && unchanged('clockRequired')
          && unchanged('tipsRequired')
          && unchanged('employeeNumber')
          && unchanged('authUids')
          && unchanged('shiftRoles');
      }

      // Nobody confers a role at or above their own. Owners are exempt.
      function roleGrantIsLegal() {
        return unchanged('accessRole')
          || myRole() == 'owner'
          || rank(incomingRole()) < rank(myRole());
      }

      allow read: if signedIn();

      allow create: if hasPerm('employees.edit')
                    && (myRole() == 'owner'
                        || rank(incomingRole()) < rank(myRole()));

      allow update: if (
        // A person may edit their own non-privileged profile fields.
        (isSelf(employeeId) && selfEditIsBenign())
        ||
        // Or an authorized admin acting strictly downward.
        (hasPerm('employees.edit')
         && canAccessSensitive(employeeId)
         && roleGrantIsLegal())
      );

      // Archive, never hard-delete — archived staff are kept for the record
      // (spec §18) and excluded from scheduling/eligibility.
      allow delete: if false;

      // Compensation: own rate is visible to the employee (spec §17 confirms
      // "show own rate: yes"); otherwise requires employees.editPay AND below-level.
      match /private/compensation {
        allow read: if isSelf(employeeId)
                    || (hasPerm('employees.editPay') && canAccessSensitive(employeeId));
        allow write: if hasPerm('employees.editPay') && canAccessSensitive(employeeId);
      }

      // Admin-only: schedulingNotes + permissionOverrides.
      // The employee may READ their own overrides (hasPerm() needs it) but
      // never write them, and never sees schedulingNotes written about them.
      match /private/admin {
        allow read: if isSelf(employeeId)
                    || (hasPerm('employees.view') && canAccessSensitive(employeeId));
        // -- QUARANTINED DIRTY DENIAL - revisit before Phase 2 rules --------
        // This single condition still denies by throwing rather than returning
        // false. It is CORRECT: every rules test covering it passes, including
        // equal-rank denial and staff-cannot-write-own-overrides. The fault is
        // evaluation hygiene, not authorization.
        //
        // Ruled out by bisection (do not retry): chained .get(k, default) ->
        // `in` + indexing; diff().affectedKeys() -> per-field equality;
        // token.get() -> `in` + dot access; dropping overrides entirely;
        // splitting write into create+update (worse - both then evaluate);
        // reordering the conjunction.
        //
        // What DID fix the other site: resolve each map ONCE and pass it as a
        // parameter, because rules do not memoize function results. This rule
        // already does that and still throws, so the remaining cause looks
        // specific to reading employees/{id}/private/admin from inside a rule
        // that writes a private/admin document.
        //
        // Surfaced by `npm run test:rules:clean`, which fails by design.
        allow write: if hasPerm('permissions.manage') && canAccessSensitive(employeeId);
      }
    }

    // ── permissions/roleDefaults ─────────────────────────────────────────────
    // Readable by every signed-in user: the client needs it to resolve its own
    // effective permissions. Writable only with permissions.manage.

    match /permissions/{docId} {
      allow read: if signedIn();
      allow write: if hasPerm('permissions.manage');
    }

    // ── shiftRoles ───────────────────────────────────────────────────────────
    // The role catalog + canCoverRoleIds hierarchy. Everyone reads (needed to
    // render role chips and evaluate trade eligibility); settings.manage writes.

    match /shiftRoles/{roleId} {
      allow read: if signedIn();
      allow write: if hasPerm('settings.manage');
    }

    // ── settings ─────────────────────────────────────────────────────────────

    match /settings/app {
      allow read: if signedIn();
      allow write: if hasPerm('settings.manage');
    }

    // AI provider metadata only — keys live in Secret Manager and are NEVER
    // stored here or returned to a client (spec §13).
    match /settings/aiProviders {
      allow read: if hasPerm('ai.configureKeys');
      allow write: if false; // Cloud Function only.
    }

    // ── availability ─────────────────────────────────────────────────────────
    // `availability/{weekId}_{employeeId}`, plus the rolling baseline at
    // `availability/recurring_{employeeId}` (the sentinel week key — see the
    // header of src/lib/db/availability.ts). One path match covers both.
    //
    // §5: staff submit their OWN availability; managers holding
    // `availability.approve` submit or review on someone's behalf, scoped to
    // their department (owner/GM run the whole house).
    //
    // ── THE THURSDAY 23:59 ET DEADLINE IS **NOT** ENFORCED HERE ──────────────
    // §5 locks a week's submissions at Thursday 23:59 America/New_York. Rules
    // cannot express that:
    //   • There is no timezone database in the rules language. "Thursday 23:59
    //     ET" is 03:59 UTC Friday in EDT and 04:59 UTC Friday in EST, and which
    //     one applies depends on the week. Hard-coding either is wrong for half
    //     the year, and src/lib/deadlines.ts exists precisely because that
    //     wrongness is not acceptable.
    //   • Deriving the deadline from the weekId string would need int() over
    //     substrings of client-controlled data — which THROWS on a malformed id
    //     and would hand us exactly the dirty denial this file is disciplined
    //     against.
    //   • Comparing against a deadline timestamp ON THE DOCUMENT would work,
    //     but no such field exists: submitAvailability() writes none, and a
    //     field the submitting client supplies is a lock the client picks.
    // So the deadline is enforced in two other places and honestly nowhere
    // else: submitAvailability() raises AvailabilityLockedError client-side
    // (UX), and the Phase 2 `submitAvailability` callable will enforce it
    // server-side with real tz math before writing. What the rules below DO
    // enforce is the half that is expressible and that actually protects the
    // data: you may only write YOUR OWN availability, and you may never review
    // your own submission.

    match /availability/{docId} {

      function incomingEmployeeId() {
        return (request.resource != null && 'employeeId' in request.resource.data)
          ? request.resource.data.employeeId
          : '__nobody__';
      }

      function existingEmployeeId() {
        return (resource != null && 'employeeId' in resource.data)
          ? resource.data.employeeId
          : '__nobody__';
      }

      // On create there is no `resource`, so the payload names the subject; on
      // update and delete the STORED value is authoritative, which is what
      // stops a payload from re-pointing someone else's document at you.
      function subjectEmployeeId() {
        return resource != null ? existingEmployeeId() : incomingEmployeeId();
      }

      // Withdrawing a temporary override (clearTemporaryAvailability) is a
      // delete, so `request.resource` is null and none of the payload guards
      // above can run — ownership of the STORED document is the whole test.
      function selfWithdrawal() {
        return request.resource == null && isSelf(existingEmployeeId());
      }

      // ONE resolution of each map, passed down. See the note above hasPerm().
      function mayReview(overrides, defaults, role) {
        return effectivePerm('availability.approve', overrides, defaults, role)
          && scopedTo(subjectEmployeeId());
      }

      allow read: if hasIdentity()
                  && (isSelf(existingEmployeeId()) || hasPerm('availability.viewAll'));

      // Submitting (create OR update to a fresh pending state) is
      // Cloud-Function-only (functions/src/availabilityActions.ts) — the
      // Thursday 23:59 ET deadline (spec §5) needs a real tz database, which
      // rules do not have, and a client-side-only check is trivially
      // bypassed. A plain client write can still WITHDRAW their own
      // still-open temporary override, or REVIEW someone else's (both of
      // which carry no deadline question), but can no longer submit or
      // resubmit availability directly.
      allow write: if hasIdentity()
                   && (selfWithdrawal()
                       || mayReview(myOverrides(), roleDefaults(), myRole()));
    }

    // ── schedules/{weekId} ───────────────────────────────────────────────────
    // The week document is the unit of publication (§6).
    //
    // A DRAFT MUST NEVER REACH STAFF. Staff hold `schedule.view`, so that key
    // alone cannot be the gate — the gate is the week's own status. Anything
    // that is not explicitly 'published' or 'republished' is a draft, including
    // a document with a missing or unrecognised status.

    match /schedules/{weekId} {

      function incomingStatus() {
        return (request.resource != null && 'status' in request.resource.data)
          ? request.resource.data.status
          : 'draft';
      }

      function storedStatus() {
        return (resource != null && 'status' in resource.data)
          ? resource.data.status
          : 'draft';
      }

      function isLiveNow() {
        return resource != null && liveStatusOf(resource.data);
      }

      // Crossing the publish line in EITHER direction is a publish action:
      // pulling a live week back to draft un-tells everyone they are working.
      function crossesPublishLine() {
        return incomingStatus() != storedStatus()
          && (isLiveStatus(incomingStatus()) || isLiveStatus(storedStatus()));
      }

      function mayRead(overrides, defaults, role) {
        return effectivePerm('schedule.view', overrides, defaults, role)
          && (isLiveNow() || canEditSchedules(overrides, defaults, role));
      }

      function mayWrite(overrides, defaults, role) {
        return canEditSchedules(overrides, defaults, role)
          && (!crossesPublishLine()
              || effectivePerm('schedule.publish', overrides, defaults, role));
      }

      allow read: if hasIdentity() && mayRead(myOverrides(), roleDefaults(), myRole());
      allow create, update: if hasIdentity()
                            && mayWrite(myOverrides(), roleDefaults(), myRole());
      // Weeks are history. Cancel the shifts, never drop the week.
      allow delete: if false;

      // ── schedules/{weekId}/shifts/{shiftId} ────────────────────────────────
      // Editors see everything. Staff see a shift only when ALL of:
      //   • the parent week is published, and
      //   • the shift itself is published (a shift added after a publish sits
      //     at 'draft' until someone republishes — that is what makes the §6
      //     republish step real rather than decorative), and
      //   • it is their own shift or their own department (§17).
      //
      // RESOLVED — read this before touching the staff query path again.
      // Firestore evaluates a rule against every document a query matches and
      // fails the WHOLE query if any one of them is denied; it does not filter.
      // This rule was correct from the start (department + published-status
      // scoping, per document); the bug was client-side: listShifts() used to
      // narrow department with a post-fetch .filter(), so a staff member
      // calling it unfiltered for a mixed FOH/BOH or mixed draft/published week
      // was denied outright. Fixed by pushing `department` and `status` into
      // the actual Firestore query — see listPublishedShiftsForDepartment() and
      // the JSDoc on listShifts() in src/lib/db/schedules.ts. This rule was
      // NOT widened; the confirmed policy stands: staff see only their own
      // department's published schedule, managers+ see both.

      match /shifts/{shiftId} {

        function shiftIsLive() {
          return resource != null
            && 'status' in resource.data
            && resource.data.status == 'published';
        }

        function isMyShift() {
          return resource != null
            && 'employeeId' in resource.data
            && resource.data.employeeId == myEmployeeId();
        }

        function isMyDepartment(myDept) {
          return resource != null
            && 'department' in resource.data
            && resource.data.department == myDept;
        }

        function incomingShiftStatus() {
          return (request.resource != null && 'status' in request.resource.data)
            ? request.resource.data.status
            : 'draft';
        }

        function storedShiftStatus() {
          return (resource != null && 'status' in resource.data)
            ? resource.data.status
            : 'draft';
        }

        // Flipping a shift live is publishing, whatever else the write does.
        function goesLive() {
          return incomingShiftStatus() == 'published'
            && storedShiftStatus() != 'published';
        }

        function mayReadShift(overrides, defaults, role) {
          return canEditSchedules(overrides, defaults, role)
            || (effectivePerm('schedule.view', overrides, defaults, role)
                && shiftIsLive()
                && weekIsPublished(weekId)
                && (isMyShift() || isMyDepartment(myDepartment())));
        }

        function mayWriteShift(overrides, defaults, role) {
          return canEditSchedules(overrides, defaults, role)
            && (!goesLive()
                || effectivePerm('schedule.publish', overrides, defaults, role));
        }

        allow read: if hasIdentity()
                    && mayReadShift(myOverrides(), roleDefaults(), myRole());
        allow write: if hasIdentity()
                     && mayWriteShift(myOverrides(), roleDefaults(), myRole());
      }
    }

    // ── shiftTemplates ───────────────────────────────────────────────────────
    // Day-part headcount + skill requirements (§6). Read by everyone who can
    // look at a schedule — the builder renders met/unmet badges from these and
    // they contain no personal data. `schedule.edit` writes.

    match /shiftTemplates/{templateId} {
      allow read: if signedIn();
      allow write: if hasPerm('schedule.edit');
    }

    // ── timeOff ──────────────────────────────────────────────────────────────
    // Staff raise their own request and read it back; approving takes
    // `timeoff.approve` AND the requester's department (owner/GM excepted).
    //
    // Reads are NOT department-scoped, deliberately. Approvers work from a
    // queue — one query across every pending request — and a per-document
    // department test would fail that whole query rather than filter it (same
    // Firestore query semantics as the shifts note above). A time-off request
    // carries a date range and a reason, not compensation or discipline, and
    // §17 does not list it as sensitive; the boundary worth defending is who
    // may APPROVE, which is scoped below.

    match /timeOff/{requestId} {

      function incomingEmployeeId() {
        return (request.resource != null && 'employeeId' in request.resource.data)
          ? request.resource.data.employeeId
          : '__nobody__';
      }

      function existingEmployeeId() {
        return (resource != null && 'employeeId' in resource.data)
          ? resource.data.employeeId
          : '__nobody__';
      }

      function subjectEmployeeId() {
        return resource != null ? existingEmployeeId() : incomingEmployeeId();
      }

      // The shape a requester may write: pending, unreviewed, no verdict.
      // This is what stops "approve my own time off" — a staff member can only
      // ever move their request between pending states.
      function isUnreviewed() {
        return request.resource != null
          && 'status' in request.resource.data
          && request.resource.data.status == 'pending'
          && (!('reviewedBy' in request.resource.data)
              || request.resource.data.reviewedBy == null)
          && (!('reviewedAt' in request.resource.data)
              || request.resource.data.reviewedAt == null);
      }

      // An already-reviewed request is closed to its owner: reopening an
      // approved absence by editing it would silently un-approve the coverage
      // a manager already planned around.
      function stillOpen() {
        return resource == null
          || (('status' in resource.data) && resource.data.status == 'pending');
      }

      function ownRequest() {
        return isSelf(subjectEmployeeId())
          && isSelf(incomingEmployeeId())
          && isUnreviewed()
          && stillOpen();
      }

      function mayApprove(overrides, defaults, role) {
        return effectivePerm('timeoff.approve', overrides, defaults, role)
          && scopedTo(subjectEmployeeId());
      }

      function mayRequest(overrides, defaults, role) {
        return effectivePerm('timeoff.request', overrides, defaults, role)
          && ownRequest();
      }

      allow read: if hasIdentity()
                  && (isSelf(existingEmployeeId()) || hasPerm('timeoff.approve'));

      allow create, update: if hasIdentity()
                            && writeTimeOff(myOverrides(), roleDefaults(), myRole());

      // Requests are the paper trail for an absence — withdrawn is a status,
      // not an erasure.
      allow delete: if false;

      function writeTimeOff(overrides, defaults, role) {
        return mayRequest(overrides, defaults, role)
          || mayApprove(overrides, defaults, role);
      }
    }

    // ── invites ──────────────────────────────────────────────────────────────
    // The invitee is SIGNED OUT when they open an invite link, so reading an
    // invite by token is served by the getInvite Cloud Function, not by a rule.
    // Admin SDK bypasses these rules, which is what makes that work.

    match /invites/{inviteId} {
      allow read: if hasPerm('employees.edit');
      allow create: if hasPerm('employees.edit');
      allow update, delete: if false; // acceptInvite Function only.
    }

    // ── auditLog ─────────────────────────────────────────────────────────────
    // Append-only, and only from the server. Immutable once written (spec §17).

    match /auditLog/{entryId} {
      allow read: if hasPerm('settings.manage');
      allow create, update, delete: if false; // Cloud Function only.
    }

    // ── punches (spec §8, §9, §17) ────────────────────────────────────────────
    // EVERY write is Cloud-Function-only. The self-service clock-in/out path
    // needs a server timestamp ("never trust the device clock", spec §8) and
    // the manual-punch and edit paths need editHistory + an auditLog entry
    // (§17) — both are exactly the "independently verified, not a client
    // write with a promise to also log it later" shape recordScheduleOverride
    // already established. So unlike trades (below), there is no client-
    // writable slice here at all: create/update/delete are all `false`, and
    // recordPunch/editPunch write through the Admin SDK, which bypasses this
    // rule entirely.
    //
    // READ is the one thing worth a client rule. Spec §4 lists "punch
    // editing" (not viewing) as the below-your-level-sensitive example, so
    // viewing is department-scoped only; canAccessSensitive is reserved for
    // the edit path itself (enforced inside editPunch, since all writes are
    // false here anyway).

    match /punches/{punchId} {
      function subjectEmployeeId() {
        return resource != null && 'employeeId' in resource.data
          ? resource.data.employeeId
          : '__nobody__';
      }

      // `scopedTo(subjectEmployeeId())` looks correct here but is NOT
      // list-query-safe: it calls `departmentOfTarget()`, a `get()` keyed on
      // `resource.data.employeeId` — a field the query doesn't constrain.
      //
      // A `list` request is all-or-nothing: Firestore evaluates the rule
      // against the query's POTENTIAL result set — using only the query's
      // own where()-pinned values and the caller's claims, never real
      // per-document data — and denies the WHOLE query if it can't prove
      // every possible match would be allowed ("security rules are not
      // filters"; confirmed Aug 14 2026, reproduced identically at 5 and 20
      // distinct employees, so it's not a get()-count ceiling). Removing the
      // get() (denormalizing `department` onto the punch, same reasoning as
      // `Trade.department`) was necessary but NOT sufficient by itself — the
      // comparison below still reads `resource.data.department`, a field the
      // query left unconstrained, so it remained unprovable.
      //
      // The other half of the fix is the CLIENT: it now adds
      // `where('department', '==', actor.department)` to this query for any
      // caller who isn't Owner/GM (src/lib/db/punches.ts). With that filter
      // present, `resource.data.department` is pinned to the same literal
      // value `myDepartment()` resolves to for that caller, so the equality
      // below IS provable — do not remove the client-side filter.
      function punchDepartment() {
        return 'department' in resource.data ? resource.data.department : '__no_target_dept__';
      }

      function mayViewPunch() {
        return ownerOrGm() || myDepartment() == punchDepartment();
      }

      allow read: if hasIdentity()
                  && (isSelf(subjectEmployeeId())
                      || (hasPerm('punches.viewAll') && mayViewPunch()));

      allow create, update, delete: if false;
    }

    // ── tipReports (spec §8, §9, §17) ─────────────────────────────────────────
    // Same shape as punches: every write is Cloud-Function-only (recordPunch
    // creates the tip report in the SAME transaction as the clock-out punch,
    // so "clock-out gates tips" — spec §8 — is a server-enforced atomicity,
    // not a client sequencing convention a bypassed client could skip).
    //
    // Tips ARE explicitly named in spec §4's below-level example ("tips of
    // others"), unlike punches, so viewing here also requires
    // canAccessSensitive, not just department scope.

    match /tipReports/{reportId} {
      function subjectEmployeeId() {
        return resource != null && 'employeeId' in resource.data
          ? resource.data.employeeId
          : '__nobody__';
      }

      // `employeeAccessRole` is denormalized onto the tip report at creation
      // time (functions/src/punchActions.ts) so this reads it directly, no
      // extra fetch. Missing the field fails closed to 'owner' — a
      // below-level check must never widen because a record predates it.
      function tipReportEmployeeRole() {
        return 'employeeAccessRole' in resource.data ? resource.data.employeeAccessRole : 'owner';
      }

      // A `list` request is all-or-nothing: Firestore evaluates the rule
      // against the query's POTENTIAL result set, using only the query's own
      // where()-pinned values and the caller's claims — never per-document
      // (confirmed Aug 14 2026; "security rules are not filters"). A rank
      // COMPARISON (rank(myRole()) > rank(tipReportEmployeeRole())) can't be
      // proven this way even after denormalizing the field, because the
      // comparison's truth still varies per document and the query doesn't
      // pin `employeeAccessRole` to any single value.
      //
      // A MEMBERSHIP check against a literal role list, mirrored exactly by
      // the client's `where('employeeAccessRole', 'in', viewableTipRoles(...))`
      // (src/lib/permissions/index.ts), IS provable: every value the query
      // can return is drawn from that same literal set, so the rule holds
      // for all of them. Do not go back to a rank() comparison here.
      function viewableTipRoles(role) {
        return role == 'owner' ? ['owner', 'gm', 'manager', 'supervisor', 'staff']
             : role == 'gm' ? ['manager', 'supervisor', 'staff']
             : role == 'manager' ? ['supervisor', 'staff']
             : role == 'supervisor' ? ['staff']
             : [];
      }

      function mayViewTipReport() {
        return tipReportEmployeeRole() in viewableTipRoles(myRole());
      }

      allow read: if hasIdentity()
                  && (isSelf(subjectEmployeeId())
                      || (hasPerm('tips.viewAll') && mayViewTipReport()));

      allow create, update, delete: if false;
    }

    // ── tasks (spec §10, Phase 3(b)) ───────────────────────────────────────────
    // Definitions only. Nothing but the admin Task Manager screen (Settings →
    // Tasks, `tasks.manage`) ever reads this collection directly — every
    // materialized `taskInstance` denormalizes title/titleEs/dueRule/
    // requiresPhoto at creation time (same reasoning as
    // `TipReport.employeeAccessRole`'s denormalization note), so "My Tasks"
    // and the completion dashboard never need to join back to a definition.
    // That means there is no staff-facing read case to gate here at all.

    match /tasks/{taskDefId} {
      allow read, write: if hasPerm('tasks.manage');
    }

    // ── taskInstances (spec §10, Phase 3(b)) ──────────────────────────────────
    // EVERY write is Cloud-Function-only, same shape as punches/tipReports
    // above: materialization (`tasksScheduled.ts`) and completion
    // (`completeTaskInstance`) both need to independently re-verify state
    // (claim scope, missed-boundary timing) rather than trust a client write,
    // and both run under the Admin SDK, which bypasses this rule entirely.
    //
    // READ mirrors `punches`' exact department-scoped shape, deliberately: an
    // employee always sees their own assigned instances; a "my pool tasks"
    // list additionally needs `tasks.complete` + a department match — the
    // BROAD, PROVABLE boundary (list-query-safe per the Aug 14 2026 lesson:
    // a rule branch reading a `resource.data` field the query doesn't
    // constrain poisons the whole list). Precise role/employee eligibility to
    // actually CLAIM a pool instance is re-verified server-side in
    // `completeTaskInstance` against the live `TaskDefinition`, never trusted
    // from this rule or from `TaskInstance.department` alone — same
    // department-broad-list/precise-action-eligibility split as Shift Pool's
    // "Up for grabs" browsing. `tasks.manage` (the admin dashboard) reads
    // every department, unscoped.

    match /taskInstances/{instanceId} {
      function subjectEmployeeId() {
        return resource != null && 'assigneeEmployeeId' in resource.data
          ? resource.data.assigneeEmployeeId
          : '__nobody__';
      }

      // Same list-query-safety shape as `punchDepartment()` above: the
      // client pins `where('department', '==', actor.department)` for any
      // caller who isn't `tasks.manage` (src/lib/db/taskInstances.ts) so this
      // equality is provable across the whole result set.
      function taskInstanceDepartment() {
        return 'department' in resource.data ? resource.data.department : '__no_target_dept__';
      }

      // A "POOL" instance specifically — unclaimed (`assigneeEmployeeId ==
      // null`), matching `trades`' own `mayReadTrade()` requiring `status ==
      // 'open'` below (same file, further down) before granting a
      // same-department non-party a read. Provable the same way: the client
      // query pins `where('assigneeEmployeeId', '==', null)` for this exact
      // case (src/lib/db/taskInstances.ts's `listMyTaskInstances`), so this
      // equality is never unconstrained across the result set. WITHOUT this,
      // any `tasks.complete` holder (effectively every employee) could read
      // every instance in their own department, including ones already
      // assigned to a named coworker — found by the Phase 3(b) rules-test
      // pass (Aug 16 2026), fixed here, never shipped.
      function isUnclaimedPoolInstance() {
        return !('assigneeEmployeeId' in resource.data) || resource.data.assigneeEmployeeId == null;
      }

      function mayViewPoolInstance() {
        return hasPerm('tasks.manage')
          || (hasPerm('tasks.complete') && isUnclaimedPoolInstance() && myDepartment() == taskInstanceDepartment());
      }

      allow read: if hasIdentity()
                  && (isSelf(subjectEmployeeId()) || mayViewPoolInstance());

      allow create, update, delete: if false;
    }

    // ── payPeriods (spec §11, Phase 3(c)) ─────────────────────────────────────
    // Full sensitive-read gate, ruled by Rafa: payroll reads are Owner/GM
    // ONLY — `payroll.view` was tightened off Manager's default grant set
    // specifically for this (src/lib/permissions/defaults.ts), a stricter
    // bar than punches/tipReports' below-level+department scoping. Unlike
    // those two, there is no per-document department/rank field to reason
    // about here — a flat `hasPerm()` gate needs no client-side query
    // cooperation to hold (no `where()` shape can make an ineligible caller
    // provable), so a single-document read and an unscoped `list` fail
    // identically for anyone without the permission. Every write — lock,
    // unlock, export-stamping — is Cloud-Function-only
    // (`functions/src/payrollActions.ts`), same shape as punches/tipReports:
    // lock/unlock need the audit guarantee and unlock's required-reason
    // check enforced server-side, not trusted from a client claim.

    match /payPeriods/{periodId} {
      allow read: if hasPerm('payroll.view');
      allow create, update, delete: if false;
    }

    // ── policies (spec §12, Phase 4) ──────────────────────────────────────────
    // Read broadly — everyone needs to read a policy they're being asked to
    // sign, and the handbook generally. Versioned + immutable: an edit is
    // ALWAYS a new document (new id, `version: version + 1`, same
    // `familyId`), never a mutation of an existing one — the one exception,
    // `isCurrent`, exists specifically so creating the new version can flip
    // the superseded doc's flag without a Cloud Function.

    match /policies/{policyId} {

      // Field-by-field, not diff().affectedKeys().hasOnly() — same house
      // style as employees' unchanged() (above): explicit equality states
      // the intent plainly and is the documented preference over diff() in
      // this file already.
      function policyUnchanged(field) {
        return (field in request.resource.data) == (field in resource.data)
          && (!(field in request.resource.data)
              || request.resource.data[field] == resource.data[field]);
      }

      // The narrow update shape: isCurrent + updatedAt may change, every
      // other Policy field must not — same intent as
      // diff(resource.data).affectedKeys().hasOnly(['isCurrent', 'updatedAt']),
      // expressed without diff().
      function onlySupersedeFieldsChanged() {
        return policyUnchanged('familyId')
          && policyUnchanged('title')
          && policyUnchanged('titleEs')
          && policyUnchanged('bodyMarkdown')
          && policyUnchanged('bodyMarkdownEs')
          && policyUnchanged('version')
          && policyUnchanged('category')
          && policyUnchanged('requiresSignature')
          && policyUnchanged('activeFrom')
          && policyUnchanged('locationId')
          && policyUnchanged('createdAt');
      }

      allow read: if hasIdentity();

      allow create: if hasPerm('policies.manage');

      // -- QUARANTINED DIRTY DENIAL, same class as employees/private/admin's
      // (above) — revisit only if a real bisection lead turns up ----------
      // `npm run test:rules:clean` flags this rule as a genuine (never-
      // resolved) evaluation error for a CREATE of a brand-new policy
      // document by a caller WITHOUT policies.manage. It is a diagnostic
      // artifact, not an authorization defect: every test in
      // policies.rules.test.ts — including every create/update boundary —
      // passes. Investigated and ruled out: guarding with `resource !=
      // null` before the field comparison; replacing diff() with the
      // per-field policyUnchanged() above (same fix employees' own
      // unchanged() already models); reordering the && so the get()-free
      // check runs first. None changed the outcome.
      //
      // Working theory, consistent with the employees/private/admin
      // precedent: a plain client write to a path with no existing document
      // is speculatively checked against BOTH `allow create` and `allow
      // update` before Firestore knows which applies (documented at this
      // file's header). When the request truly resolves as a CREATE, the
      // sibling `update` rule is evaluated once in Firestore's untyped
      // discovery pass (where get()-backed hasPerm() calls are unresolved)
      // and, because it is not the operative rule for the real decision,
      // never receives the second, data-backed pass that would let it reach
      // a clean verdict. This should affect ANY collection whose `create`
      // and `update` are separate `allow` statements that BOTH call
      // hasPerm() — `employees` (L322 & L326) fits that shape too, and
      // simply has no existing rules test that creates a brand-new employee
      // doc through a denied client write to surface it. Not a rules bug;
      // do not rewrite this rule chasing it further; do not re-run the
      // bisection.
      allow update: if hasPerm('policies.manage') && onlySupersedeFieldsChanged();

      allow delete: if false; // A permanent historical record — no version is ever removed.
    }

    // ── signatures (spec §12, Phase 4) ────────────────────────────────────────
    // Every write is Cloud-Function-only (submitSignature/
    // recordRefusedToSign) — a signature's PDF + email leg must be server-
    // side, so there is no client-writable shape here at all, same as
    // punches/tipReports/taskInstances.
    //
    // READ splits by how sensitive the TARGET is. A policy signature carries
    // no disciplinary sensitivity — "3 employees haven't signed the new
    // policy" is a `policies.manage` concern, not `discipline.view`. A
    // disciplinary-target signature is exactly as sensitive as the action it
    // belongs to (below-level, same rule disciplinaryActions itself uses).

    match /signatures/{signatureId} {
      function subjectEmployeeId() {
        return resource != null && 'employeeId' in resource.data
          ? resource.data.employeeId
          : '__nobody__';
      }

      function targetType() {
        return resource != null && 'targetType' in resource.data
          ? resource.data.targetType
          : '__none__';
      }

      function mayViewAsPolicyAdmin() {
        return targetType() == 'policy' && hasPerm('policies.manage');
      }

      // Single-document reads only (a specific disciplinary action's own
      // signature) — nothing in this app lists signatures broadly by
      // below-level rank. If that ever changes, this needs the same
      // membership-check treatment `disciplinaryActions` documents below,
      // for the identical list-query-safety reason.
      function mayViewAsDisciplineAdmin() {
        return targetType() == 'disciplinaryAction'
          && hasPerm('discipline.view')
          && canAccessSensitive(subjectEmployeeId());
      }

      allow read: if hasIdentity()
                  && (isSelf(subjectEmployeeId())
                      || mayViewAsPolicyAdmin()
                      || mayViewAsDisciplineAdmin());

      allow create, update, delete: if false;
    }

    // ── disciplinaryActions (spec §4, §12, §17) ───────────────────────────────
    // The MOST sensitive collection in this app (Rafa's own ruling) — full
    // trio, strict below-level, no peer-file reads (two Managers cannot see
    // each other's), staff read only their own. Every write is Cloud-
    // Function-only (issueDisciplinaryAction / submitSignature /
    // recordRefusedToSign) — never a raw client write, matching punches'
    // shape for the same "needs the audit guarantee" reason.

    match /disciplinaryActions/{actionId} {
      function subjectEmployeeId() {
        return resource != null && 'employeeId' in resource.data
          ? resource.data.employeeId
          : '__nobody__';
      }

      // Same list-query-safety shape as `tipReports`' `employeeAccessRole`
      // (Aug 14 2026 fix): a RANK comparison can never be proven for a
      // `list` request — only a MEMBERSHIP check against a literal set the
      // query's own where() pins. Missing the field fails closed to
      // 'owner' — a below-level check must never widen because a record
      // predates it.
      function targetAccessRole() {
        return 'employeeAccessRole' in resource.data ? resource.data.employeeAccessRole : 'owner';
      }

      function viewableDisciplineRoles(role) {
        return role == 'owner' ? ['owner', 'gm', 'manager', 'supervisor', 'staff']
             : role == 'gm' ? ['manager', 'supervisor', 'staff']
             : role == 'manager' ? ['supervisor', 'staff']
             : role == 'supervisor' ? ['staff']
             : [];
      }

      function mayViewAsAdmin() {
        return hasPerm('discipline.view') && targetAccessRole() in viewableDisciplineRoles(myRole());
      }

      allow read: if hasIdentity()
                  && (isSelf(subjectEmployeeId()) || mayViewAsAdmin());

      allow create, update, delete: if false;
    }

    // ── disciplinaryLadder (spec §12, Phase 4) ────────────────────────────────
    // A single org-wide config doc, not per-employee-sensitive itself — every
    // employee needs to read it to render their OWN progress-ladder widget's
    // "what happens next" copy (cross-referenced against their own, already-
    // readable disciplinaryActions). Writing the ESCALATION POLICY (the
    // thresholds/consequences themselves) is a settings-level decision, not
    // a day-to-day `discipline.issue` action — gated `settings.manage`
    // (Owner/GM), same bar as other org-wide policy configs.

    match /disciplinaryLadder/{ladderId} {
      allow read: if hasIdentity();
      allow write: if hasPerm('settings.manage');
    }

    // ── trades (spec §7, §17) ─────────────────────────────────────────────────
    // Unlike punches/tipReports, POSTING a trade risks nothing irreversible —
    // no shift reassignment happens until a manager approves — so create and
    // "cancel my own still-open post" are ordinary client writes, gated here.
    // Everything that risks putting someone under-qualified or double-booked
    // on the floor (claim, accept, approve/decline) goes through a Cloud
    // Function that independently recomputes spec §7's eligibility — the
    // same reasoning recordScheduleOverride already established for the
    // skill-floor block — so those transitions are NOT reachable from this
    // rule at all; `allow update` below permits only the cancel shape.

    match /trades/{tradeId} {

      function shiftPath(weekId, shiftId) {
        return /databases/$(database)/documents/schedules/$(safeId(weekId))/shifts/$(safeId(shiftId));
      }

      function referencedShift() {
        return exists(shiftPath(request.resource.data.weekId, request.resource.data.shiftId))
          ? get(shiftPath(request.resource.data.weekId, request.resource.data.shiftId)).data
          : null;
      }

      // A trade posted by the shift's own owner, or a manager posting an
      // already-open shift (fromEmployeeId null, postedBy the manager).
      function selfPost() {
        return request.resource.data.fromEmployeeId == myEmployeeId()
          && request.resource.data.postedBy == myEmployeeId()
          && effectivePerm('trades.request', myOverrides(), roleDefaults(), myRole());
      }

      function managerPost() {
        return request.resource.data.fromEmployeeId == null
          && request.resource.data.postedBy == myEmployeeId()
          && effectivePerm('trades.manualAssign', myOverrides(), roleDefaults(), myRole());
      }

      // Department and eligibilitySnapshot must match the ACTUAL shift, not
      // whatever the client typed — the shift doc is the authority both for
      // approval-scoping (department) and for the display snapshot.
      function matchesShift() {
        let shift = referencedShift();
        return shift != null
          && request.resource.data.department == shift.department
          && request.resource.data.eligibilitySnapshot.roleId == shift.roleId
          && request.resource.data.eligibilitySnapshot.requiredSkillLevel == shift.requiredSkillLevel;
      }

      function freshPost() {
        return request.resource.data.status == 'open'
          && request.resource.data.claimedBy == null
          && request.resource.data.approvedBy == null
          && (request.resource.data.type == 'pool'
              ? request.resource.data.toEmployeeId == null
              : request.resource.data.toEmployeeId != null);
      }

      function mayCreate() {
        return hasIdentity()
          && (selfPost() || managerPost())
          && matchesShift()
          && freshPost();
      }

      // The only client-writable transition: the poster withdraws their own
      // still-open post. Checked field-by-field, not via diff() — this file's
      // employees rule found `diff().affectedKeys()` makes a genuine denial's
      // reason unreadable; explicit equality says exactly which field failed.
      function identityUnchanged() {
        return request.resource.data.fromEmployeeId == resource.data.fromEmployeeId
          && request.resource.data.postedBy == resource.data.postedBy
          && request.resource.data.toEmployeeId == resource.data.toEmployeeId
          && request.resource.data.claimedBy == resource.data.claimedBy
          && request.resource.data.type == resource.data.type
          && request.resource.data.shiftId == resource.data.shiftId
          && request.resource.data.weekId == resource.data.weekId
          && request.resource.data.department == resource.data.department
          && request.resource.data.eligibilitySnapshot == resource.data.eligibilitySnapshot;
      }

      function isOwnCancel() {
        return resource.data.status == 'open'
          && request.resource.data.status == 'cancelled'
          && resource.data.postedBy == myEmployeeId()
          && identityUnchanged();
      }

      // Pool visibility is intentionally broader than true eligibility: the
      // full spec §7 check (role coverage graph + skill + conflicts) is not
      // cheaply expressible here, and a false-eligible READ leaks nothing
      // sensitive — only that a shift in your own department is available.
      // The real boundary is claimTrade's independently-recomputed check;
      // this only has to stop a DIFFERENT department from seeing it.
      function mayReadTrade() {
        return hasIdentity()
          && (resource.data.fromEmployeeId == myEmployeeId()
              || resource.data.postedBy == myEmployeeId()
              || resource.data.toEmployeeId == myEmployeeId()
              || resource.data.claimedBy == myEmployeeId()
              || hasPerm('trades.approve')
              // Pool-only, and open only: a direct offer stays private to its
              // two named parties until (if ever) it needs a manager, and an
              // already-claimed/decided pool trade has nothing left for a
              // browsing non-party to do with it.
              || (resource.data.type == 'pool'
                  && resource.data.status == 'open'
                  && myDepartment() == resource.data.department));
      }

      allow read: if mayReadTrade();
      allow create: if mayCreate();
      allow update: if hasIdentity() && isOwnCancel();
      allow delete: if false;
    }

    // ── default deny ─────────────────────────────────────────────────────────
    // Collections for later phases (tasks, taskInstances, policies,
    // signatures, disciplinaryActions, disciplinaryLadder, payPeriods) are
    // intentionally absent and therefore denied. Each phase adds its own
    // match block together with its rules tests. Do not add a permissive
    // catch-all here.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
