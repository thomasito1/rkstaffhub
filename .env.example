# RK StaffHub — environment
#
# Local development runs entirely against the Firebase emulators using the
# demo project id below. Demo projects need NO real credentials and NO real
# Firebase project, so these placeholder values are correct for local work.
#
# Copy to .env.local and fill real values ONLY when deploying.
# .env.local is gitignored. Never commit real keys.

# Set to "true" to talk to the emulators (default for local dev).
VITE_USE_EMULATORS=true

# Emulator hosts/ports — must match firebase.json
VITE_EMULATOR_HOST=127.0.0.1
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_STORAGE_PORT=9199
VITE_EMULATOR_FUNCTIONS_PORT=5001

# Firebase config.
# For emulator work, leave the demo values as-is.
# CRITICAL: this must be a STANDALONE Firebase project.
# It must NEVER point at the existing Leah/ERP Firestore project.
VITE_FIREBASE_PROJECT_ID=demo-rk-staffhub
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-rk-staffhub.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-rk-staffhub.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# FCM web push (Phase 2+). Leave blank until push is wired.
VITE_FIREBASE_VAPID_KEY=
