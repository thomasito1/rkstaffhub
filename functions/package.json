{
  "name": "rk-staffhub-functions",
  "private": true,
  "version": "0.1.0",
  "description": "Cloud Functions for RK StaffHub — invite acceptance, custom claims, audit trail.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions --project demo-rk-staffhub"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.0.0",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.6.0",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.7.2"
  }
}
